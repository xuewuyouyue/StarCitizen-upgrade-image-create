[Unit]
Description=WB Image Generator
After=network.target

[Service]
Type=simple
User=wb-image-generator
Group=wb-image-generator
WorkingDirectory=/opt/wb-image-generator
EnvironmentFile=/etc/wb-image-generator.env
ExecStart=/usr/bin/node server.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/wb-image-generator
UMask=0077

[Install]
WantedBy=multi-user.target
